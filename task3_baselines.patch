index 0000000..a6c56f9
--- /dev/null
+++ b/src/evaluation/harness.py
@@ -0,0 +1,118 @@
+"""ONE evaluation interface for every Task-3+ method (A*, reactive, DQN, shielded DQN, later PPO / the assurance system).
+
+Fairness by construction:
+  * a method is just an object with `act(obs) -> int` (+ optional `attach`, `stats`, `last_decision`);
+  * every method sees the SAME maps, start/goal, battery and noise: an episode is fully determined by (preset, seed),
+    and the slip and sensor streams consume a fixed number of draws per step, so methods that take the same number of
+    steps see the same random numbers (common random numbers -> paired comparisons are valid);
+  * success == terminal reason "goal"; all rows come from the same code path.
+Metrics added to the Task-1 runner row: attempted_unsafe (commanded move into an obstacle/off-map, judged by the
+evaluator from ground truth), interventions/decisions (shield), plan_ms (decision latency).
+"""
+from __future__ import annotations
+
+import csv
+import time
+from pathlib import Path
+
+import numpy as np
+
+from src.config import Config, load_config
+from src.evaluation.evaluator import make_env
+from src.evaluation.runner import summarise
+
+ROW_FIELDS = ["method", "preset", "map", "success", "reason", "steps", "reward", "battery_left", "energy_used", "collisions",
+              "attempted_unsafe", "interventions", "decisions", "no_safe_action", "optimal_cost", "energy_ratio", "plan_ms"]
+SPLIT_OFFSET = {"val": 10_000, "test": 20_000}
+
+
+class GreedyAgentPolicy:
+    """Greedy (argmax) evaluation wrapper for DQN/PPO agents; exposes q_values when the agent has them."""
+
+    def __init__(self, agent, name: str):
+        self.agent, self.name = agent, name
+
+    def act(self, obs) -> int:
+        return self.agent.act(obs, greedy=True)
+
+    def q_values(self, obs):
+        return self.agent.q_values(obs)
+
+
+def _attach(policy, env) -> None:
+    for p in (policy, getattr(policy, "base", None)):
+        if p is not None and hasattr(p, "attach"):
+            p.attach(env.explored_map, env.max_battery)  # the env's PUBLIC onboard API only
+
+
+def _stat_snapshot(policy) -> tuple[int, int, int]:
+    s = getattr(policy, "stats", None)
+    return (s["decisions"], s["interventions"], s["no_safe_action"]) if s else (0, 0, 0)
+
+
+def run_episode_ext(env, ev, policy, seed: int, method: str = "", preset: str = "") -> dict:
+    obs = env.reset(seed=seed)
+    d0 = _stat_snapshot(policy)
+    energy = collisions = unsafe = 0
+    total_r, done, info, t_dec = 0.0, False, {}, 0.0
+    while not done:
+        t0 = time.perf_counter()
+        a = int(policy.act(obs))
+        t_dec += time.perf_counter() - t0
+        unsafe += ev.commanded_cell_unsafe(a)
+        obs, r, done, info = env.step(a)
+        total_r += r
+        energy += info["energy_used"]
+        collisions += info["event"].endswith("collision")
+    d1 = _stat_snapshot(policy)
+    ok = info["reason"] == "goal"
+    return {"method": method, "preset": preset, "map": env.map_id, "success": int(ok), "reason": info["reason"],
+            "steps": info["steps"], "reward": round(total_r, 3), "battery_left": env.battery, "energy_used": energy,
+            "collisions": int(collisions), "attempted_unsafe": int(unsafe), "interventions": d1[1] - d0[1],
+            "decisions": d1[0] - d0[0], "no_safe_action": d1[2] - d0[2], "optimal_cost": ev.optimal_cost,
+            "energy_ratio": (energy / ev.optimal_cost) if ok else float("nan"),
+            "plan_ms": 1000.0 * t_dec / max(info["steps"], 1)}
+
+
+def evaluate_method(policy, cfg_path, seeds, method: str, preset: str, out_csv=None):
+    """Fresh env per call (same cfg, same seed list -> same episodes for every method). Returns (rows, summary)."""
+    cfg = load_config(cfg_path)
+    env, ev = make_env(cfg.env, 0)
+    _attach(policy, env)
+    rows = [run_episode_ext(env, ev, policy, s, method, preset) for s in seeds]
+    summ = summarise(rows)
+    n = len(rows)
+    summ.update({"attempted_unsafe_per_episode": sum(r["attempted_unsafe"] for r in rows) / n,
+                 "mean_energy_used": float(np.mean([r["energy_used"] for r in rows])),
+                 "mean_plan_ms": float(np.mean([r["plan_ms"] for r in rows])),
+                 "intervention_rate": (sum(r["interventions"] for r in rows) / max(sum(r["decisions"] for r in rows), 1))
+                 if any(r["decisions"] for r in rows) else None})
+    if out_csv:
+        Path(out_csv).parent.mkdir(parents=True, exist_ok=True)
+        with open(out_csv, "w", newline="") as f:
+            w = csv.DictWriter(f, ROW_FIELDS)
+            w.writeheader()
+            w.writerows(rows)
+    return rows, summ
+
+
+def build_policy(kind: str, cfg: Config, ckpt: str | None = None, seed: int = 0):
+    """kind: random | reactive | astar | dqn | dqn_shield   (ppo / ppo_shield are added after DQN and A* are stable)."""
+    from src.policies.astar_battery import BatteryAwareAStar
+    from src.policies.baseline_policies import RandomPolicy
+    from src.policies.rule_shield import RuleShield
+    from src.policies.sim32_heuristic import ReactiveExplorer
+    if kind == "random":
+        return RandomPolicy(seed)
+    if kind == "reactive":
+        return ReactiveExplorer(seed)
+    if kind == "astar":
+        return BatteryAwareAStar(nominal_energy=cfg.env.ref_energy_cost, seed=seed)
+    if kind in ("dqn", "dqn_shield"):
+        from src.agents.dqn_agent import DQNAgent
+        probe, _ = make_env(cfg.env, 0)
+        agent = DQNAgent(probe.obs_dim, probe.n_actions, cfg.dqn, seed=seed)
+        agent.load(ckpt)
+        base = GreedyAgentPolicy(agent, "dqn")
+        return base if kind == "dqn" else RuleShield(base, nominal_energy=cfg.env.ref_energy_cost)
+    raise ValueError(f"unknown method {kind!r}")
diff --git a/src/policies/astar_battery.py b/src/policies/astar_battery.py
new file mode 100644
index 0000000..5a00008
--- /dev/null
+++ b/src/policies/astar_battery.py
@@ -0,0 +1,104 @@
+"""Battery-aware A* over the EXPLORED map (Task 3 baseline). Onboard information only.
+
+Plans on `explored_map()` (what the rover has sensed/touched) plus its own position, goal offset and battery.
+It never sees the true grid. Every cell gets an explicit expected cost:
+
+  known free cell      nominal energy of its estimated terrain class (normal/sand/rock = documented nominal table)
+  UNKNOWN cell         `unknown_energy` + a risk premium that GROWS as the battery drains (less reserve = less gambling)
+  believed obstacle    soft wall (`obstacle_penalty`): a false detection cannot deadlock the planner; a collision later
+                       proves it (`bumped`) and the cell becomes a hard wall
+  revisited cell       small `visit_penalty` per prior visit (breaks ping-pong loops caused by slips / sensor noise)
+
+It replans every step. `last_plan` records the estimate so the Task-4 monitor/logs can use it.
+Nominal energies are the rover's DOCUMENTED estimates: under a dynamics shift the true costs differ and A* is not told.
+"""
+from __future__ import annotations
+
+import heapq
+
+import numpy as np
+
+_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))  # same action convention as the env (defined locally on purpose)
+
+
+class BatteryAwareAStar:
+    name = "battery_astar"
+
+    def __init__(self, nominal_energy=(1.0, 3.0, 5.0), unknown_energy: float = 2.0, unknown_risk: float = 1.0,
+                 risk_battery_gain: float = 2.0, obstacle_penalty: float = 40.0, visit_penalty: float = 0.3,
+                 feasibility_margin: float = 1.0, seed: int = 0):
+        if min(nominal_energy) < 1 or unknown_energy < 1:
+            raise ValueError("all expected cell costs must be >= 1 (keeps the Manhattan heuristic admissible)")
+        self.nominal = tuple(float(v) for v in nominal_energy)
+        self.unknown_energy, self.unknown_risk, self.risk_gain = unknown_energy, unknown_risk, risk_battery_gain
+        self.obstacle_penalty, self.visit_penalty, self.margin = obstacle_penalty, visit_penalty, feasibility_margin
+        self.rng = np.random.default_rng(seed)
+        self._get_map, self._capacity = None, None
+        self.last_plan: dict = {}
+
+    def attach(self, get_map, battery_capacity: float) -> None:
+        """`get_map` = the env's public `explored_map` (onboard). `battery_capacity` = the rover's nominal capacity."""
+        self._get_map, self._capacity = get_map, float(battery_capacity)
+
+    # ------------------------------------------------------------------ cost model
+    def _grids(self, m, battery_ratio: float):
+        known = m.seen > 0
+        tm = m.terrain_mean
+        e = np.where(np.nan_to_num(tm, nan=0.0) < 0.15, self.nominal[0],
+                     np.where(np.nan_to_num(tm, nan=0.0) < 0.45, self.nominal[1], self.nominal[2]))
+        of = np.nan_to_num(m.obstacle_frac, nan=0.0)
+        soft = known & (of > 0.5)
+        premium = self.unknown_risk * (1.0 + self.risk_gain * (1.0 - battery_ratio))
+        energy = np.where(known, e, self.unknown_energy)           # pure energy estimate (for the feasibility check)
+        cost = np.where(known, e, self.unknown_energy + premium)   # planning cost
+        cost = np.where(soft, self.obstacle_penalty, cost) + self.visit_penalty * np.minimum(m.visits, 3)
+        cost = np.where(m.bumped, np.inf, cost)
+        return cost, np.where(soft, 1.0, energy), ~known
+
+    def _astar(self, cost, start, goal):
+        n = cost.shape[0]
+        g = np.full((n, n), np.inf)
+        g[start] = 0.0
+        parent = {}
+        h = lambda p: abs(p[0] - goal[0]) + abs(p[1] - goal[1])  # noqa: E731  (every cell costs >= 1)
+        heap = [(h(start), 0.0, start)]
+        while heap:
+            _, gc, cur = heapq.heappop(heap)
+            if cur == goal:
+                path = [cur]
+                while cur != start:
+                    cur = parent[cur]
+                    path.append(cur)
+                return path[::-1], gc
+            if gc > g[cur]:
+                continue
+            for dr, dc in _DELTAS:
+                nxt = (cur[0] + dr, cur[1] + dc)
+                if 0 <= nxt[0] < n and 0 <= nxt[1] < n and np.isfinite(cost[nxt]):
+                    ng = gc + cost[nxt]
+                    if ng < g[nxt]:
+                        g[nxt] = ng
+                        parent[nxt] = cur
+                        heapq.heappush(heap, (ng + h(nxt), ng, nxt))
+        return None, np.inf
+
+    # ------------------------------------------------------------------ policy
+    def act(self, obs) -> int:
+        if self._get_map is None:
+            raise RuntimeError("call attach(env.explored_map, env.max_battery) before act()")
+        m = self._get_map()
+        n = m.seen.shape[0]
+        pos = (int(round(obs[0] * (n - 1))), int(round(obs[1] * (n - 1))))
+        goal = (pos[0] + int(round(obs[2] * (n - 1))), pos[1] + int(round(obs[3] * (n - 1))))
+        cost, energy, unknown = self._grids(m, float(obs[4]))
+        path, total = self._astar(cost, pos, goal)
+        battery = float(obs[4]) * self._capacity
+        if path is None or len(path) < 2:
+            self.last_plan = {"path": None, "cost": np.inf, "energy_est": np.inf, "feasible": False, "n_unknown": 0}
+            return int(self.rng.integers(4))
+        cells = path[1:]
+        e_est = float(sum(energy[c] for c in cells))
+        self.last_plan = {"path": path, "cost": float(total), "energy_est": e_est,
+                          "feasible": e_est * self.margin <= battery, "n_unknown": int(sum(unknown[c] for c in cells))}
+        step = (path[1][0] - pos[0], path[1][1] - pos[1])
+        return _DELTAS.index(step)
diff --git a/src/policies/rule_shield.py b/src/policies/rule_shield.py
new file mode 100644
index 0000000..6a602b8
--- /dev/null
+++ b/src/policies/rule_shield.py
@@ -0,0 +1,87 @@
+"""Conventional rule-based safety shield (Task 3 baseline). Onboard information only.
+
+Wraps any base policy. For the proposed action it checks three explicit, testable rules; if one fails it overrides with
+the best remaining action (highest base Q-value if the base exposes `q_values`, otherwise closest to the goal):
+
+  invalid_action   the action would leave the map
+  obstacle         the target cell is believed blocked: detected in the current 5x5 window, believed so in the explored
+                   map (majority of readings), or proven by an earlier collision
+  battery          even the best case cannot work out: entry energy of the target (nominal table, from its reading)
+                   exceeds the battery, or battery after the move < Manhattan distance to goal (>= 1 energy per step)
+
+Deliberately NO uncertainty or OOD signal: that is what the Task-4 runtime-assurance system adds. Per-decision
+counters (`stats`) give the intervention rate and the rules that fired. If every action violates a rule, the base action
+is kept and counted in `no_safe_action`.
+"""
+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+_DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_WIN0, _W, _R = 9, 5, 2   # window block of the 59-d observation (see docs/OBSERVATION_SCHEMA_V2.md)
+RULES = ("invalid_action", "obstacle", "battery")
+
+
+class RuleShield:
+    name = "rule_shield"
+
+    def __init__(self, base, nominal_energy=(1.0, 3.0, 5.0)):
+        self.base, self.nominal = base, tuple(float(v) for v in nominal_energy)
+        self._get_map, self._capacity = None, None
+        self.stats = {"decisions": 0, "interventions": 0, "no_safe_action": 0, "by_rule": Counter()}
+        self.last_decision: dict = {}
+
+    def attach(self, get_map, battery_capacity: float) -> None:
+        self._get_map, self._capacity = get_map, float(battery_capacity)
+
+    def _entry_energy(self, reading: float) -> float:
+        return self.nominal[0] if reading < 0.15 else self.nominal[1] if reading < 0.45 else self.nominal[2]
+
+    def violations(self, obs, action: int, m) -> list[str]:
+        n = m.seen.shape[0]
+        x, y = int(round(obs[0] * (n - 1))), int(round(obs[1] * (n - 1)))
+        gx, gy = x + int(round(obs[2] * (n - 1))), y + int(round(obs[3] * (n - 1)))
+        dr, dc = _DELTAS[action]
+        tx, ty = x + dr, y + dc
+        if not (0 <= tx < n and 0 <= ty < n):
+            return ["invalid_action"]
+        out = []
+        reading = float(obs[_WIN0 + (_R + dr) * _W + (_R + dc)])
+        belief = m.obstacle_frac[tx, ty]
+        if reading >= 0.999 or m.bumped[tx, ty] or (not np.isnan(belief) and belief > 0.5):
+            out.append("obstacle")
+        battery = float(obs[4]) * self._capacity
+        entry = self._entry_energy(reading) if reading < 0.999 else 1.0
+        if entry > battery or battery - entry < abs(tx - gx) + abs(ty - gy):
+            out.append("battery")
+        return out
+
+    def act(self, obs) -> int:
+        if self._get_map is None:
+            raise RuntimeError("call attach(env.explored_map, env.max_battery) before act()")
+        m = self._get_map()
+        proposed = int(self.base.act(obs))
+        self.stats["decisions"] += 1
+        bad = self.violations(obs, proposed, m)
+        self.last_decision = {"proposed": proposed, "executed": proposed, "violations": bad, "intervened": False}
+        if not bad:
+            return proposed
+        self.stats["interventions"] += 1
+        self.stats["by_rule"][bad[0]] += 1
+        ok = [a for a in range(4) if not self.violations(obs, a, m)]
+        self.last_decision["intervened"] = True
+        if not ok:
+            self.stats["no_safe_action"] += 1
+            self.last_decision["no_safe_action"] = True
+            return proposed
+        if hasattr(self.base, "q_values"):
+            q = np.asarray(self.base.q_values(obs))
+            choice = max(ok, key=lambda a: q[a])
+        else:
+            n = m.seen.shape[0]
+            gdx, gdy = obs[2] * (n - 1), obs[3] * (n - 1)
+            choice = max(ok, key=lambda a: _DELTAS[a][0] * gdx + _DELTAS[a][1] * gdy)
+        self.last_decision["executed"] = int(choice)
+        return int(choice)
